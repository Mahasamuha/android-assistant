# Compose variables. Copy to deploy/.env (gitignored).
# Host address and port the reverse proxy uses to reach the gateway (when not using compose.proxy-network.yaml).
GATEWAY_BIND=127.0.0.1:<gateway-port>
# Brave Search API key for the MCP server's web_search tool (https://brave.com/search/api/).
BRAVE_API_KEY=<brave-api-key>
# Optional Pirate Weather API key (https://pirateweather.net/): adds the server's get_weather, with alerts
# and next-hour rain; without it the phone's Open-Meteo get_weather is used.
PIRATE_WEATHER_API_KEY=<pirate-weather-api-key>
# Optional Plex settings: all four enable the MCP server's music_find, used by the phone's play_music to
# turn what you said into the exact names in your Plex music library. Needs PLEX_URL and PLEX_TOKEN.
PLEX_URL=https://<plex-host>:32400
PLEX_TOKEN=<plex-token>
# The name on the Plex server's certificate, which is not the host above: see the server's https connection
# in plex.tv's resources list, or the certificate subject. Any label in place of the first one works.
PLEX_TLS_NAME=<anything>.<hash>.plex.direct
# Title of the Plex library section that holds the music.
PLEX_MUSIC_SECTION=Music
# Docker network of the reverse proxy (only with compose.proxy-network.yaml).
PROXY_NETWORK=<proxy-network>
# Optional: pin the gateway and MCP images to a published tag (e.g. 0.3.1, or sha-1a2b3c4) instead of latest.
IMAGE_TAG=latest
