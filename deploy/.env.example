# Compose variables. Copy to deploy/.env (gitignored).
# Host address and port the reverse proxy uses to reach the gateway (when not using compose.proxy-network.yaml).
GATEWAY_BIND=127.0.0.1:<gateway-port>
# Brave Search API key for the MCP server's web_search tool (https://brave.com/search/api/).
BRAVE_API_KEY=<brave-api-key>
# Optional Pirate Weather API key (https://pirateweather.net/): adds the server's get_weather, with alerts
# and next-hour rain; without it the phone's Open-Meteo get_weather is used.
PIRATE_WEATHER_API_KEY=<pirate-weather-api-key>
# Docker network of the reverse proxy (only with compose.proxy-network.yaml).
PROXY_NETWORK=<proxy-network>
