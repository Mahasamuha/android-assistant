# Copy to deploy/local/gateway.env (gitignored).

# Issuer exactly as it appears in the token's "iss" claim (Authentik includes a trailing slash).
ISSUER_URL=https://<issuer-host>/application/o/<application-slug>/
# Optional; discovered from the issuer if unset.
# JWKS_URL=https://<issuer-host>/application/o/<application-slug>/jwks/
AUDIENCE=<audience>

# Must match BIFROST_VIRTUAL_KEY in bifrost.env. Generate with: echo "sk-bf-$(openssl rand -hex 24)"
UPSTREAM_VIRTUAL_KEY=sk-bf-<random>

RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_BURST=5
# How long request/response bodies are kept (e.g. 24h, 7d); 0 disables body logging outside debug mode.
LOG_BODY_RETENTION=24h
# Debug mode turns itself off after this long.
DEBUG_DURATION=30m
